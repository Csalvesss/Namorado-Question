// Regras de seguranca do Firestore para Guava Education.
// Aplicar no Firebase Console -> Firestore -> Regras.
//
// Como funciona:
// - /users/{uid}             : doc do perfil. So o dono le e escreve.
// - /users/{uid}/sessions/*  : sessoes de prova. So o dono.
// - /users/{uid}/srs/*       : estado de repeticao espacada por card. So o dono.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuaria autenticada le e escreve apenas o proprio perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcolecoes: sessions e srs sao dados de progresso por usuaria
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /srs/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Cursos criados pela usuaria (com flashcards/questoes embarcados)
      match /customCourses/{courseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Plano de estudo: disciplinas, aulas semanais e provas
      match /subjects/{subjectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /classes/{classId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /exams/{examId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
