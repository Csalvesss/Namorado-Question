# Firebase Web SDK config — pegue em Console Firebase > Configurações do Projeto > Geral > Seus apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Lista de e-mails permitidos a se cadastrar/logar, separados por vírgula
# Ex.: VITE_ALLOWED_EMAILS=ela@gmail.com,amiga1@gmail.com,voce@gmail.com
VITE_ALLOWED_EMAILS=
